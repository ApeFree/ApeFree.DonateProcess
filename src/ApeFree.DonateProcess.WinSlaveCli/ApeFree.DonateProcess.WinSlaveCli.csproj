<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Title>ApeFree.DonateProcess.WinSlaveCli</Title>
    <Product>ApeFree.DonateProcess.WinSlaveCli</Product>
    <Version>0.1.0.0</Version>
    <Authors>Guijie Lee</Authors>
    <Company>ApeFree</Company>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Description>ApeFree.DonateProcess 远程进程管理与执行共享客户端独立工具 (Slave 节点端)</Description>

    <!-- 单文件与修剪打包配置 -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApeFree.DonateProcess\ApeFree.DonateProcess.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ApeFree.ApeRpc.BytesIO" Version="0.0.3-alpha61009" />
    <PackageReference Include="STTech.BytesIO.P2P" Version="3.3.0.1-alpha61010" />
  </ItemGroup>

  <!-- 修剪保护：避免 RPC 反射调度、数据契约 DTO 及 Libp2p 在修剪时被意外剥离 -->
  <ItemGroup>
    <TrimmerRootAssembly Include="ApeFree.DonateProcess" />
    <TrimmerRootAssembly Include="ApeFree.DonateProcess.WinSlaveCli" />
    <TrimmerRootAssembly Include="ApeFree.ApeRpc" />
    <TrimmerRootAssembly Include="ApeFree.ApeRpc.BytesIO" />
    <TrimmerRootAssembly Include="STTech.BytesIO" />
    <TrimmerRootAssembly Include="STTech.CodePlus" />
    <TrimmerRootAssembly Include="ApeFree.Protocols.Json" />
    <TrimmerRootAssembly Include="STTech.BytesIO.P2P" />
    <TrimmerRootAssembly Include="Nethermind.Libp2p" />
    <TrimmerRootAssembly Include="Nethermind.Libp2p.Core" />
  </ItemGroup>

</Project>
