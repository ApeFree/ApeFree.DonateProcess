<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <Title>ApeFree.DonateProcess</Title>
    <Product>ApeFree.DonateProcess</Product>
    <Version>0.1.0.0</Version>
    <Authors>Guijie Lee</Authors>
    <Company>ApeFree</Company>
    <Copyright>Copyright © 2022-2026 ApeFree, All Rights Reserved.</Copyright>
    <Description>远程主动捐赠式进程管理与脚本执行契约与核心库。提供跨平台/Windows进程生命周期管理、连续多轮交互式CMD/PowerShell会话及远程ApeRpc调用支持。</Description>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <RepositoryUrl>https://github.com/ApeFree/ApeFree.DonateProcess</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ApeFree.ApeRpc" Version="0.0.3-alpha61009" />
    <PackageReference Include="System.Management" Version="10.0.11" />
  </ItemGroup>

</Project>
